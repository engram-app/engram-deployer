# engram-deployer environment — copy to engram-deployer.env and edit.
# This file is sourced by /etc/rc.d/rc.engram-deployer.

# ── TLS material ────────────────────────────────────────────────────────
# Generated by the plugin's install hook on first install. Pinned in CI
# via SHA-256 of the cert file.
DEPLOYER_CERT_FILE=/boot/config/plugins/engram-deployer/cert.pem
DEPLOYER_KEY_FILE=/boot/config/plugins/engram-deployer/key.pem

# ── Listener ────────────────────────────────────────────────────────────
DEPLOYER_ADDR=:8443

# ── /deploy: OIDC claim allowlist ───────────────────────────────────────
# These four claims pin /deploy to ONE GitHub workflow on ONE repo
# pushing to ONE branch. Token replay alone isn't enough — the issuer
# certifies all four match the originating workflow run.
DEPLOYER_REPOSITORY=engram-app/Engram
DEPLOYER_REF=refs/heads/main
DEPLOYER_WORKFLOW_REF=engram-app/Engram/.github/workflows/ci.yml@refs/heads/main
DEPLOYER_AUDIENCE=engram-deploy

# ── Source IP allowlist (CI runner VM) ──────────────────────────────────
# Shared between /deploy and /tf-apply.
DEPLOYER_ALLOWED_IPS=10.20.99.10

# ── /deploy: execution ──────────────────────────────────────────────────
DEPLOYER_IMAGE=ghcr.io/engram-app/engram
DEPLOYER_TEMPLATE_DIR=/boot/config/plugins/dockerMan/templates-user
DEPLOYER_DOCKER_PATH=docker
DEPLOYER_UPDATE_CONTAINER_PATH=/usr/local/emhttp/plugins/dynamix.docker.manager/scripts/update_container
DEPLOYER_HEALTH_POLL_INTERVAL=2s
DEPLOYER_HEALTH_MAX_WAIT=60s

# ── /tf-apply: enable + OIDC pin ────────────────────────────────────────
# Optional endpoint that runs `terraform apply` against the local Docker
# socket, driven by engram-infra's tf-apply.yml workflow. Setting ANY of
# the DEPLOYER_TF_APPLY_* / DEPLOYER_TF_AWS_* vars enables the endpoint;
# all required ones must then be set together or the daemon refuses to
# start.
#
# Leave all of the section below blank to disable /tf-apply.
#
#DEPLOYER_TF_APPLY_REPOSITORY=engram-app/engram-infra
#DEPLOYER_TF_APPLY_REF=refs/heads/main
#DEPLOYER_TF_APPLY_WORKFLOW_REF=engram-app/engram-infra/.github/workflows/tf-apply.yml@refs/heads/main
#DEPLOYER_TF_APPLY_AUDIENCE=engram-tf-apply

# ── /tf-apply: execution ────────────────────────────────────────────────
#DEPLOYER_TF_APPLY_REPO_URL=https://github.com/engram-app/engram-infra.git
#DEPLOYER_TF_APPLY_ROOT_DIR=main/envs/staging-fastraid
#DEPLOYER_TF_APPLY_WORKDIR=/var/lib/engram-deployer/tf
#DEPLOYER_TF_BINARY_PATH=terraform
#DEPLOYER_TF_GIT_BINARY_PATH=git
#DEPLOYER_TF_DOCKER_HOST=unix:///var/run/docker.sock
#
# Terraform provider plugin cache: providers downloaded once are reused on
# every later `terraform init`, so a transient registry/GitHub blip can't
# fail a run whose providers are already cached. MUST be on PERSISTENT
# storage — /var/* is wiped on Unraid reboot, and the workdir above is
# wiped every run. The daemon creates this dir at startup. Default below;
# leave blank to disable the cache.
#DEPLOYER_TF_PLUGIN_CACHE_DIR=/mnt/cache/appdata/engram-deployer/plugin-cache

# ── /tf-apply: AWS creds for TF state RW ────────────────────────────────
# Issued by engram-app/engram-infra terraform (user `engram-deployer-tf`,
# scoped to s3://engram-infra-tfstate-751667630925/main/staging-fastraid.tfstate*).
# Pull with: AWS_PROFILE=engram-infra-operator \
#   terraform -chdir=main/envs/staging output -raw deployer_tf_secret_access_key
#
#DEPLOYER_TF_AWS_ACCESS_KEY_ID=AKIA...
#DEPLOYER_TF_AWS_SECRET_ACCESS_KEY=...
#DEPLOYER_TF_AWS_REGION=us-east-1

# ── /tf-apply: GitHub App credentials for cloning private repos ─────────
# Required when DEPLOYER_TF_APPLY_REPO_URL is https://github.com/... and
# the target repo is PRIVATE. Daemon mints a fresh ~1-hour installation
# token per /tf-apply request using these credentials, then injects it as
# `https://x-access-token:<token>@github.com/...` for the git clone.
#
# If the repo is public OR you use an SSH URL (git@github.com:...), all
# three of these may be left blank.
#
# Use the existing engram-infra-tf App (org-wide install on engram-app):
#   App ID:          3743326
#   Installation ID: 133088664
# PEM should be the same private-key.pem already used for the App's CI
# integration in the engram-infra repo, copied onto FastRaid at an
# exec-capable path (/mnt/cache/appdata/... not /boot/...).
#
#DEPLOYER_TF_APPLY_GH_APP_ID=3743326
#DEPLOYER_TF_APPLY_GH_APP_INSTALLATION_ID=133088664
#DEPLOYER_TF_APPLY_GH_APP_PEM_PATH=/mnt/cache/appdata/engram-deployer/gh-app/private-key.pem

# ── /tf-plan: PR-time plan preview ──────────────────────────────────────
# /tf-plan piggybacks on /tf-apply: same repo, same TF root, same AWS
# creds, same orchestrator. Auto-enabled whenever /tf-apply is enabled.
#
# PR-event OIDC tokens differ from push-event tokens: `ref` varies per
# PR so the validator can't pin it. Instead it pins `sub` (constant for
# pull_request: `repo:<owner>/<repo>:pull_request`) and prefix-matches
# `workflow_ref` to ensure only tf-plan.yml can hit the endpoint.
#
# Tunables below are optional; defaults match engram-infra conventions.
#
#DEPLOYER_TF_PLAN_AUDIENCE=engram-tf-plan
#DEPLOYER_TF_PLAN_WORKFLOW_FILE=tf-plan.yml
